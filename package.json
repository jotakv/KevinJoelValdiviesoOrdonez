{
  "name": "kevin-multi-cv-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "validate": "node --import tsx scripts/validate.ts && astro check",
    "build": "node --import tsx scripts/validate.ts && astro build",
    "export:pdf": "node --import tsx scripts/export-pdfs.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:site": "node --import tsx scripts/test-site.ts",
    "verify": "npm run validate && npm run build && npm run export:pdf && npm test && npm run test:site && npm run test:discovery",
    "test:discovery": "node --import tsx scripts/test-discovery.ts"
  },
  "dependencies": {
    "astro": "^5.15.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1",
    "sanitize-html": "^2.17.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "pdfjs-dist": "^5.4.296",
    "playwright": "1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
